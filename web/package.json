{
  "name": "greenhouse-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "lint": "eslint \"src/**/*.{js,ts,html}\" --quiet",
    "lint:fix": "eslint \"src/**/*.{js,ts,html}\" --fix",
    "format": "prettier --write \"src/**/*.{js,ts,html,scss,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,html,scss,css,json}\"",
    "prepare": "husky",
    "pre-commit": "lint-staged"
  },
  "private": true,
  "dependencies": {
    "@angular-eslint/schematics": "^21.1.0",
    "@angular/animations": "21.1.1",
    "@angular/common": "21.1.1",
    "@angular/compiler": "21.1.1",
    "@angular/core": "21.1.1",
    "@angular/forms": "21.1.1",
    "@angular/platform-browser": "21.1.1",
    "@angular/platform-browser-dynamic": "21.1.1",
    "@angular/router": "21.1.1",
    "@primeuix/themes": "^2.0.3",
    "@tailwindcss/postcss": "^4.1.13",
    "@tailwindcss/vite": "^4.1.13",
    "angular-gridster2": "^21.0.1",
    "chart.js": "^4.5.0",
    "date-fns": "4.1.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "ngx-cookie-service": "21.1.0",
    "ngx-json-viewer": "^3.2.1",
    "postcss": "^8.5.6",
    "prettier": "3.8.1",
    "primeicons": "^7.0.0",
    "primeng": "^21.0.4",
    "rxjs": "7.8.2",
    "tailwindcss": "^4.1.13"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "21.1.0",
    "@angular-eslint/eslint-plugin-template": "21.1.0",
    "@angular/build": "^21.1.1",
    "@angular/cli": "21.1.1",
    "@angular/compiler-cli": "21.1.1",
    "@angular/localize": "21.1.1",
    "@eslint/js": "9.39.2",
    "@types/jasmine": "5.1.15",
    "@typescript-eslint/eslint-plugin": "8.54.0",
    "@typescript-eslint/parser": "8.54.0",
    "eslint": "9.27.0",
    "globals": "17.1.0",
    "husky": "^9.1.7",
    "jasmine-core": "5.13.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "lint-staged": "^16.2.0",
    "postcss": "^8.5.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.html": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{scss,css,json}": [
      "prettier --write"
    ]
  }
}
