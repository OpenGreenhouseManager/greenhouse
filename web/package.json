{
  "name": "greenhouse-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "lint": "eslint \"src/**/*.{js,ts,html}\"",
    "lint:fix": "eslint \"src/**/*.{js,ts,html}\" --fix",
    "format": "prettier --write \"src/**/*.{js,ts,html,scss,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,html,scss,css,json}\"",
    "prepare": "cd .. && husky web/.husky",
    "pre-commit": "lint-staged"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.4",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@fontsource-variable/nunito": "^5.3.0",
    "@primeuix/themes": "^3.1.0",
    "angular-gridster2": "^22.0.0",
    "date-fns": "4.4.0",
    "echarts": "^6.1.0",
    "ngx-cookie-service": "22.0.0",
    "ngx-echarts": "^22.0.0",
    "ngx-json-viewer": "^3.2.1",
    "primeicons": "^8.0.2",
    "primeng": "^22.1.3",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.3",
    "@angular/localize": "22.2.3",
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitest/browser-playwright": "^5.0.5",
    "angular-eslint": "^22.6.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "globals": "17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.31",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.html": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{scss,css,json}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "@angular/build": {
      "vite": "8.3.5"
    }
  }
}
